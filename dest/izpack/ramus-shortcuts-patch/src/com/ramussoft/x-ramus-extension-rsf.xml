<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-ramus-extension-rsf">
    <glob pattern="*.rsf"/>
    <comment>Ramus Application File (legacy)</comment>
    <icon name="x-ramus-extension-rsf"/>
  </mime-type>
  <!--
    Проєкт нового формату — каталог, а каталог із програмою не пов'яжеш.
    Тому подвійним клацанням відкривають його опис: файл project.ramus у
    корені проєкту. Застосунок сам піднімається до каталогу.
  -->
  <mime-type type="application/x-ramus-project">
    <glob pattern="*.ramus"/>
    <comment>Ramus Project</comment>
    <icon name="x-ramus-project"/>
  </mime-type>
</mime-info>
